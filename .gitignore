# The XC API token. xcbot.py creates xc_api_token.txt with a placeholder on
# first run; xc_api_token.txt.example is the committed copy of that placeholder.
xc_api_token.txt
*_token.txt
!*_token.txt.example

# Fetched XC data. Contains your tenant name, the Bot Defense service host name
# and its egress IPs -- real infrastructure detail, and regenerable in seconds
# with `xcbot.py fetch`. Commit it in a PRIVATE repo if you want the audit
# trail; never in a public one.
botdefense_inputs.json
*_inputs.json
*_raw_infra.json
*_raw_policy.json

# Generated artifacts -- same reasoning, plus they are outputs, not sources.
out/

# Vendor connector iRules, kept locally for reference. Not imported by this
# tool, not ours to republish, and they carry a policy-specific telemetry header
# prefix. Deliberately broad rather than by filename: every .txt at the repo
# root is local reference material. The committed placeholders end in .example,
# so they are unaffected.
/*.txt
!/requirements.txt

# Blog draft. Writing about the tool, not part of it -- and it quotes the vendor
# connector iRules above, which are not ours to republish.
blog/

# Local tooling state: machine addresses and shell history.
.claude/settings.local.json

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Editor config -- personal preference, not part of the tool.
.vscode/
